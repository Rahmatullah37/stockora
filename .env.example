# =============================================================================
# Stockora environment variables
# Copy this file to ".env.local" and fill in the values. NEVER commit .env.local.
# =============================================================================

# Supabase -> Project Settings -> API
# Safe for the browser (protected by Row Level Security).
NEXT_PUBLIC_SUPABASE_URL=
# Supabase may call this the "anon" key or the "publishable" key. Paste it here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The public address of your website. Used in verification / reset-password emails.
# Local development: http://localhost:3000
# Production: https://your-app.vercel.app (or your own domain)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PRIVATE — server only. Not used in Phase 1; it will be needed for Super Admin
# and payment webhooks in Phase 5. Never put it in client code or on GitHub.
SUPABASE_SERVICE_ROLE_KEY=
